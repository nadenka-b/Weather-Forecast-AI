# --- Приложение ---
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true

# --- База данных ---
# Локальная разработка: SQLite (по умолчанию). Продакшен (docker-compose): PostgreSQL.
# DATABASE_URL=postgresql+asyncpg://weather:weather@db:5432/weather_forecast
DATABASE_URL=sqlite+aiosqlite:///./weather_forecast.db

# --- LLM (Этап 11) ---
# LLM_PROVIDER: lm_studio | hf_local | api
# LM Studio: приложение -> Developer -> Start Server (порт 1234, OpenAI-совместимый API)
LLM_PROVIDER=lm_studio
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=qwen2.5-7b-instruct
# Попыток Tool Calling до fallback-правила (SARIMA через auto_arima)
LLM_MAX_FALLBACK_ATTEMPTS=3

# --- RAG (Этап 10) ---
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=weather_cases
EMBEDDING_DIM=128
RRF_K=60

# --- Фоновые задачи / кэш (Этапы 11–14) ---
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_ENABLED=true

# --- Агентный цикл ---
MAX_ITERATIONS=3

# --- Безопасность (Этап 4) ---
JWT_SECRET=change-me-before-commit
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
