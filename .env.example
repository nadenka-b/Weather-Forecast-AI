# --- Приложение ---
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true

# --- База данных ---
# Локальная разработка: SQLite (по умолчанию). Продакшен (docker-compose): PostgreSQL.
# DATABASE_URL=postgresql+asyncpg://weather:weather@db:5432/weather_forecast
DATABASE_URL=sqlite+aiosqlite:///./weather_forecast.db

# --- LLM (Этап 11) ---
# LLM_PROVIDER: lm_studio | vllm | hf_local | api | stub
# LM Studio: приложение -> Developer -> Start Server (порт 1234, OpenAI-совместимый API)
LLM_PROVIDER=lm_studio
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_MODEL=qwen2.5-7b-instruct
# Попыток Tool Calling до fallback-правила (SARIMA с автоподбором порядка)
LLM_MAX_FALLBACK_ATTEMPTS=3
# Таймаут и повторы одного вызова (сетевые сбои / 5xx / 429)
LLM_TIMEOUT=300.0
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY=1.0

# --- vLLM (опционально: LLM_PROVIDER=vllm) ---
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_MODEL=qwen2.5-7b-instruct

# --- HuggingFace Transformers (запасной локальный режим, Causal LM) ---
HF_LOCAL_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# --- Внешний API (OpenRouter и др.; бонус) — ключ не коммитить! ---
LLM_API_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_API_MODEL=qwen/qwen2.5-7b-instruct

# --- RAG (Этап 10) ---
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=weather_cases
EMBEDDING_DIM=128
RRF_K=60

# --- Фоновые задачи / кэш (Этапы 11–14) ---
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_ENABLED=true
# TASK_BACKEND: inline (в процессе API, без Redis — локальная разработка) | celery (воркер + Redis)
TASK_BACKEND=inline
# inline: выполнить задачу сразу в запросе (тесты, отладка)
TASK_EAGER=false

# --- Агентный цикл ---
MAX_ITERATIONS=3
CRITIC_PASS_THRESHOLD=7.0

# --- Безопасность (Этап 4) ---
JWT_SECRET=change-me-before-commit
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
