# Настройки для запуска в Docker (infrastructure/.env).
# Внутри контейнеров хост = имя сервиса (db, redis, qdrant), а не localhost!

# Приложение
DEBUG=true

# База данных (asyncpg-драйвер!)
POSTGRES_USER=weather
POSTGRES_PASSWORD=weather_password_123
POSTGRES_DB=weather_forecast
DATABASE_URL=postgresql+asyncpg://weather:weather_password_123@db:5432/weather_forecast

# LLM (подключается на Этапе 11; ollama — на хосте или в сети Docker)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
LLM_MAX_FALLBACK_ATTEMPTS=3

# RAG (Этап 10)
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=weather_cases
EMBEDDING_DIM=128

# Фоновые задачи / кэш (Этапы 11–14)
REDIS_URL=redis://redis:6379/0
CACHE_ENABLED=true

# Агентный цикл
MAX_ITERATIONS=3

# Безопасность (сгенерируйте свой ключ!)
JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
